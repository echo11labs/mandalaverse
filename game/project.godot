; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GOPALA — Dawn of the Valley"
run/main_scene="res://scenes/ui/front_door.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

UIEvents="*res://core/autoload/ui_events.gd"
UIRouter="*res://core/autoload/ui_router.gd"
UISettings="*res://core/autoload/ui_settings.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
EventBus="*res://autoloads/event_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/ez-tree-godot-port/plugin.cfg", "res://addons/flatten_for_llm/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/proton_scatter/plugin.cfg", "res://addons/waterways/plugin.cfg")

