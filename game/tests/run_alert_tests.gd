extends SceneTree
var checks := 0
var failures: Array[String] = []
var publications := 0
func _initialize(): run.call_deferred()
func check(value: bool, label: String):
	checks += 1
	if not value: failures.append(label); push_error(label)
func types(service) -> Array:
	return service.rows().map(func(row): return row.type)
func patch(sim, id: int, changes: Dictionary): sim._survival_service.update(id,changes,sim.logical_tick)
func run():
	var sim := GopalaSettlementSimulation.new()
	root.add_child(sim)
	sim.set_physics_process(false)
	sim.coordinate_service().configure(GopalaSettlementGridConfig.new(Vector2.ZERO,Rect2i(-16,-16,32,32),2.0,100.0))
	sim.bootstrap_session()
	var store: int = sim.entity_registry().create_entity(GopalaEntityKind.BUILDING,{&"definition_id":&"stockpile",&"construction_state":&"COMPLETED",&"position_x":0.0,&"position_z":0.0}).entity_id
	sim._storage_service.enable_locations(store)
	sim._route_service.enable(Rect2i(-16,-16,32,32))
	GopalaMvpScenario.setup(sim,Vector2.ZERO)
	var workers := sim.entity_queries().snapshots_by_kind(GopalaEntityKind.VILLAGER)
	var worker: int = workers[0].entity_id
	var notifier := GopalaAlertService.new()
	root.add_child(notifier)
	notifier.alerts_changed.connect(func(_rows): publications += 1)
	notifier.bind(sim)
	check(types(notifier).has("homeless") and types(notifier).has("idle"),"Starting unemployed/homeless settlers produce real aggregate alerts")
	check(not types(notifier).has("food") and not types(notifier).has("water"),"Starter reserves are above warning thresholds")
	var signature := notifier.rows()
	notifier.refresh()
	notifier.refresh()
	check(publications == 1 and notifier.rows() == signature,"Persistent conditions publish once, with stable order and no duplicates")
	var defensive := notifier.rows()
	defensive.clear()
	check(notifier.rows() == signature,"UI cannot mutate notifier state")
	sim.apply_authorized_transaction({&"wild_food":20-sim.resource_amount(&"wild_food"),&"water":20-sim.resource_amount(&"water")})
	notifier.refresh()
	check(not types(notifier).has("food") and not types(notifier).has("water"),"Exactly five logical minutes does not warn")
	sim.apply_authorized_transaction({&"wild_food":-1,&"water":-1})
	notifier.refresh()
	check(types(notifier).has("food") and types(notifier).has("water"),"Below five logical minutes triggers both supply warnings")
	sim.apply_authorized_transaction({&"milk":1,&"water":1})
	notifier.refresh()
	check(not types(notifier).has("food") and not types(notifier).has("water"),"Milk counts as food; restored supply clears warnings")
	patch(sim,worker,{&"health":49})
	notifier.refresh()
	check(types(notifier).has("health"),"Health below fifty triggers")
	patch(sim,worker,{&"health":50})
	notifier.refresh()
	check(not types(notifier).has("health"),"Health fifty clears")
	for w in workers:
		patch(sim,w.entity_id,{&"work_role":&"timber"})
	notifier.refresh()
	check(not types(notifier).has("idle"),"Assigned roles are not unemployed idle")
	patch(sim,worker,{&"work_role":&"NONE",&"task_kind":&"NEED",&"need_state":&"NO_FOOD"})
	notifier.refresh()
	check(not types(notifier).has("idle"),"NEED and shortage runs are excluded from idle")
	patch(sim,worker,{&"task_kind":&"NONE",&"need_state":&"SATISFIED",&"carried_amount":1})
	notifier.refresh()
	check(not types(notifier).has("idle"),"Carried goods prevent idle warning")
	patch(sim,worker,{&"carried_amount":0,&"movement_state":&"MOVING"})
	notifier.refresh()
	check(not types(notifier).has("idle"),"Movement prevents idle warning")
	patch(sim,worker,{&"movement_state":&"IDLE"})
	notifier.refresh()
	check(types(notifier).has("idle"),"Resolved exclusion immediately allows renewed idle without cooldown")
	patch(sim,worker,{&"work_role":&"timber"})
	# Housing derives from the normal survival service, not view meshes.
	for i in 2:
		sim.entity_registry().create_entity(GopalaEntityKind.BUILDING,{&"definition_id":&"dwelling",&"construction_state":&"COMPLETED",&"position_x":float(i)*0.2,&"position_z":0.1})
	sim._survival_service.tick(sim.logical_tick)
	notifier.refresh()
	check(not types(notifier).has("homeless"),"Completed homes clear housing alert")
	var capacity := sim._storage_service.stored(store,&"timber")
	patch(sim,store,{&"storage_capacity":{&"timber":capacity,&"stone":10000,&"thatch":10000,&"water":10000,&"wild_food":10000,&"milk":10000,&"fodder":10000}})
	patch(sim,worker,{&"job_status":&"STORAGE_FULL"})
	notifier.refresh()
	check(types(notifier).has("store") and notifier.rows().filter(func(r): return r.type == "store")[0].focus.entity_id == store,"Authoritative full store blocking a gatherer focuses the store")
	patch(sim,store,{&"storage_capacity":{&"timber":capacity+10,&"stone":10000,&"thatch":10000,&"water":10000,&"wild_food":10000,&"milk":10000,&"fodder":10000}})
	patch(sim,worker,{&"job_status":&"READY"})
	notifier.refresh()
	check(not types(notifier).has("store"),"Recovered capacity/job clears store warning")
	var site: int = sim.entity_registry().create_entity(GopalaEntityKind.BUILDING,{&"definition_id":&"dwelling",&"construction_state":&"WAITING_FOR_MATERIALS",&"position_x":0.4,&"position_z":0.2}).entity_id
	notifier.refresh()
	check(types(notifier).has("construction"),"Missing-material site triggers")
	patch(sim,site,{&"construction_state":&"UNDER_CONSTRUCTION"})
	notifier.refresh()
	check(not types(notifier).has("construction"),"Material recovery clears site warning")
	patch(sim,worker,{&"task_kind":&"BUILD",&"task_state":&"BLOCKED_ROUTE"})
	sim._construction_labor_service._tasks[worker] = {"blueprint_id":site}
	notifier.refresh()
	check(types(notifier).has("construction"),"Blocked builder route raises a site alert")
	sim._construction_labor_service._tasks.erase(worker)
	patch(sim,worker,{&"task_kind":&"NONE",&"task_state":&"NONE"})
	notifier.refresh()
	check(not types(notifier).has("construction"),"Resolved builder route clears site alert")
	sim.entity_registry().remove_entity(site,GopalaEntityRegistry.RemovalPolicy.CLEAR_INCOMING_REFERENCES,sim.logical_tick)
	var cow: int = sim._herd_service.animals()[0].entity_id
	var zone: int = sim.entity_registry().create_entity(GopalaEntityKind.ZONE,{&"definition_id":&"pasture",&"zone_cells":[[4,4]],&"position_x":0.4,&"position_z":0.4,&"grazing_available":0,&"grazing_consumed":0,&"cattle_capacity":2}).entity_id
	patch(sim,cow,{&"pasture_id":zone,&"herd_status":&"NO_WATER"})
	notifier.refresh()
	check(types(notifier).has("cattle_water"),"Cattle NO_WATER triggers water input warning")
	patch(sim,cow,{&"herd_status":&"READY",&"water_fed":1})
	notifier.refresh()
	check(not types(notifier).has("cattle_water"),"Resolved herd status clears cow water warning")
	patch(sim,cow,{&"herd_status":&"NO_FEED",&"fodder_fed":0})
	notifier.refresh()
	check(types(notifier).has("cattle_feed"),"Depleted grazing plus NO_FEED triggers")
	patch(sim,zone,{&"grazing_available":1})
	notifier.refresh()
	check(not types(notifier).has("cattle_feed"),"Available grazing suppresses feed warning even with stale NO_FEED")
	patch(sim,zone,{&"grazing_available":0})
	patch(sim,cow,{&"fodder_fed":1})
	notifier.refresh()
	check(not types(notifier).has("cattle_feed"),"Physically fed fodder suppresses warning")
	# Remove temporary animal/zone changes and initialize all normal herd fields.
	patch(sim,cow,{&"pasture_id":0,&"herd_status":&"NO_PASTURE",&"fodder_fed":0,&"water_fed":0})
	sim.entity_registry().remove_entity(zone,GopalaEntityRegistry.RemovalPolicy.CLEAR_INCOMING_REFERENCES,sim.logical_tick)
	sim.set_paused(false)
	sim.process_pending_commands()
	sim.advance_ticks(1)
	check(notifier._last_tick == sim.logical_tick,"Notifier observes the completed fixed tick")
	var state := GopalaSettlementSave.new().capture(sim,{})
	var codec := GopalaSettlementSave.new()
	var restored = codec.restore(state,sim,{})
	check(restored != null,"Save restore for alert recomputation: "+codec.error)
	if restored != null:
		root.add_child(restored)
		restored.set_physics_process(false)
		var loaded_notifier := GopalaAlertService.new()
		root.add_child(loaded_notifier)
		loaded_notifier.bind(restored)
		check(loaded_notifier.rows() == notifier.evaluate(),"Loaded alerts equal fresh evaluation including order, keys and focus payloads")
		check(not state.has("alerts"),"Save contains no notification history")
		loaded_notifier.free()
		restored.free()
	# Selection is delegated and stale subjects cannot be focused.
	patch(sim,worker,{&"health":49})
	notifier.refresh()
	var key := "health:%d" % worker
	var payload := notifier.focus_payload(key)
	check(not payload.is_empty() and sim.selection_service().select_entity(payload.entity_id).status != GopalaSelectionResult.Status.REJECTED,"Live alert subject can be selected through the service")
	sim.entity_registry().remove_entity(worker,GopalaEntityRegistry.RemovalPolicy.CLEAR_INCOMING_REFERENCES,sim.logical_tick)
	check(notifier.focus_payload(key).is_empty(),"Gone subject rejects stale camera jump")
	notifier.refresh()
	check(not notifier.rows().any(func(r): return r.key == key),"Removed subject clears notification")
	notifier.free()
	sim.free()
	print("GOPALA_TEST_REPORT="+JSON.stringify({"ok":failures.is_empty(),"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
