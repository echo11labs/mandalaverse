extends SceneTree
var checks := 0
var failures: Array[String] = []
func _initialize(): run.call_deferred()
func check(ok: bool, label: String):
	checks += 1
	if not ok: failures.append(label); push_error(label)
func run():
	var sim := GopalaSettlementSimulation.new()
	root.add_child(sim)
	sim.set_physics_process(false)
	sim.coordinate_service().configure(GopalaSettlementGridConfig.new(Vector2.ZERO,Rect2i(-12,-12,24,24),2.0,100.0))
	sim.bootstrap_session()
	sim._route_service.enable(Rect2i(-12,-12,24,24))
	var store := sim.entity_registry().create_entity(GopalaEntityKind.BUILDING,{&"definition_id":&"stockpile",&"position_x":0.0,&"position_z":0.0,&"construction_state":&"COMPLETED",&"storage_capacity":{&"timber":500,&"stone":500,&"thatch":500}})
	sim._storage_service.enable_locations(store.entity_id)
	var cells: Array[Vector2i] = [Vector2i(0,-1),Vector2i(0,0),Vector2i(0,1)]
	sim.occupancy_service().reserve_cells(store.entity_id,cells,0)
	sim.occupancy_service().commit_reservation(store.entity_id,0)
	var worker := sim.villager_service().spawn_villager(Vector2(-0.1,0))
	check(sim.villager_service().assign_move_task(worker,Vector2(0.1,0)),"Fixture has an actual routed villager")
	sim.selection_service().select_entity(worker)
	var route := sim.villager_service().route_snapshot(worker)
	check(route.points.size() > 2,"Route detours around occupied plots")
	var copied := sim.villager_service().route_snapshot(worker)
	copied.points.clear()
	check(sim.villager_service().route_snapshot(worker) == route,"Route inspection returns defensive copy")
	var view := GopalaDebugOverlay.new()
	root.add_child(view)
	view.bind(sim)
	var codec := GopalaSettlementSave.new()
	var before := codec.capture(sim,{},false)
	view.toggle()
	view.refresh()
	view._process(0.3)
	RenderingServer.force_draw()
	check(codec.capture(sim,{},false) == before,"Toggle, refresh, process and rendering do not mutate authority")
	var attrs := sim.entity_queries().snapshot(worker).attributes
	var expected: Array[Vector2] = [Vector2(attrs.position_x,attrs.position_z)]
	for waypoint in route.points: expected.append(waypoint)
	check(view.path_points == expected and view._path.mesh != null,"Drawn route is actual remaining movement route")
	var vertices: PackedVector3Array = view._path.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
	check(vertices.size() == route.points.size()+1,"Mesh includes current position and all remaining route points")
	for index in expected.size(): check(Vector2(vertices[index].x,vertices[index].z).is_equal_approx(expected[index]),"Drawn waypoint %d matches routing result" % index)
	check(view._label.text.contains("Job:") and view._label.text.contains("Waiting/status reason:") and view._label.text.contains("Carried:"),"Villager diagnostics include job, waiting reason and goods")
	view.developer_build = false
	view.set_release_flag(false)
	view.toggle()
	check(not view.enabled and not view._panel.visible and not view._path.visible,"Release has no overlay without flag")
	view.set_release_flag(true)
	view.toggle()
	check(view.enabled,"Release explicitly enables F3 with settings flag")
	view.set_release_flag(false)
	check(not view.enabled,"Removing release flag hides overlay immediately")
	view.developer_build = true
	view.toggle()
	check(view.enabled,"Developer build can toggle F3 without release flag")
	for index in 305: view.record_sample(float(index))
	var time := view.timings()
	check(time.count == 300 and is_equal_approx(time.average,154.5) and is_equal_approx(time.maximum,304.0),"Timing window retains exact last 300 values with correct average/max")
	view.record_sample(-1.0)
	view.record_sample(NAN)
	check(view.timings() == time,"Invalid timings rejected")
	view.samples.clear()
	sim.set_paused(false)
	sim.process_pending_commands()
	sim.advance_ticks(2)
	check(view.samples.size() == 2 and view.timings().maximum >= 0.0,"Existing tick observer signals collect real body timings")
	sim.set_paused(true)
	sim.process_pending_commands()
	sim.request_construction(&"dwelling",Vector2i(3,3))
	sim.process_pending_commands()
	var buildings := sim.entity_queries().snapshots_by_kind(GopalaEntityKind.BUILDING)
	var site := buildings[buildings.size()-1]
	check(site.entity_id != store.entity_id,"Fixture has actual construction site")
	sim.selection_service().select_entity(site.entity_id)
	before = codec.capture(sim,{},false)
	view.refresh()
	for resource in site.attributes.required_materials:
		check(view.selected_data.shortages[resource] == site.attributes.required_materials[resource],"Site shortage matches required undelivered/unreserved %s" % resource)
	check(codec.capture(sim,{},false) == before and view._label.text.contains("Site promises"),"Site inspection is read-only and includes reservation/promises/shortages")
	sim.selection_service().select_entity(store.entity_id)
	before = codec.capture(sim,{},false)
	view.refresh()
	check(view.selected_data.inventory == sim._storage_service.stocks[store.entity_id],"Store shows actual physical inventory")
	check(view.selected_data.has("reservations") and view.selected_data.has("promises") and view.path_points.is_empty(),"Store inspection exposes claims and clears old route")
	check(codec.capture(sim,{},false) == before,"Store queries never mutate stocks or claims")
	var flag_settings := GopalaGameSettings.new()
	flag_settings.storage_path = "user://tests/debug-overlay-settings.cfg"
	flag_settings.set_value("debug_overlay",true)
	check(flag_settings.save_to_disk(),"Diagnostic release flag can be saved")
	var restarted := GopalaGameSettings.new()
	restarted.storage_path = flag_settings.storage_path
	check(restarted.load_from_disk() and restarted.values.debug_overlay,"Release flag survives restart")
	view.queue_free()
	await process_frame
	check(not sim.logical_tick_advanced.has_connections() and not sim.fixed_tick_completed.has_connections(),"Observer connections removed with scene")
	sim.queue_free()
	await process_frame
	print("GOPALA_TEST_REPORT="+JSON.stringify({"ok":failures.is_empty(),"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
